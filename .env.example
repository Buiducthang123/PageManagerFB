# Copy thành .env rồi điền key thật.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Thư mục lưu dự án. Để trống = ./workspace cạnh code.
# WORKSPACE_DIR=D:\ReupData\workspace

# Whisper: medium | small | large-v3 ...  device: auto | cuda | cpu
WHISPER_MODEL=medium
WHISPER_DEVICE=auto

# Ngôn ngữ nhận diện: zh | en | yue | ja | ko | vi | auto (mặc định zh — tiếng Trung)
WHISPER_LANGUAGE=zh

# Cache model Whisper — mặc định workspace/models/whisper trên ổ D.
# Bắt buộc để tránh HuggingFace ghi vào C:\Users\... (ổ C đang đầy).
# WHISPER_CACHE_DIR=D:\ReupVideoVjpPro\workspace\models\whisper

# Thư mục draft CapCut THẬT trên máy — Stage "Assemble" ghi draft thẳng vào
# đây để mở CapCut lên là thấy ngay. Để trống = workspace/capcut_drafts
# (CapCut sẽ không tự thấy, phải tự copy qua tay).
# CAPCUT_DRAFTS_DIR=D:\Capcut Data\CapCut Drafts
