PORT=3000

# URL frontend (React dev server) - callback se redirect ve day sau khi xu ly xong
FRONTEND_URL=http://localhost:5173

# Lay tu developers.facebook.com > App cua ban > Settings > Basic
FB_APP_ID=
FB_APP_SECRET=

# URL public tro toi /facebook/callback - dung ngrok khi dev local
# Vi du: https://abcd1234.ngrok-free.app/facebook/callback
FB_REDIRECT_URI=

# Graph API version - kiem tra version moi nhat tai developers.facebook.com/docs/graph-api/changelog
FB_GRAPH_VERSION=v21.0

# Configuration ID tao trong: Dang nhap bang Facebook > Cau hinh (Configurations)
# Asset type = Pages, chon cac permission can dung
FB_LOGIN_CONFIG_ID=
